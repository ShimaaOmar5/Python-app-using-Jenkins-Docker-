pipeline {
    agent any

    environment {
        APP_NAME = 'py-app'
        REPO_URL = 'https://github.com/ShimaaOmar5/Python-app-using-Jenkins-Docker-.git'
    }

    stages {
        stage('Getting Repo Files') {
            steps {
                git branch: 'main', url: "${REPO_URL}"
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build -t ${APP_NAME}:${BUILD_NUMBER} .
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'Docker_Python_App',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x
                        echo "$DOCKER_PASSWORD" | docker login \
                            --username "$DOCKER_USERNAME" \
                            --password-stdin

                        docker tag "${APP_NAME}:${BUILD_NUMBER}" \
                            "$DOCKER_USERNAME/${APP_NAME}:${BUILD_NUMBER}"

                        docker push \
                            "$DOCKER_USERNAME/${APP_NAME}:${BUILD_NUMBER}"

                        docker logout
                    '''
                }
            }
        }

        stage('Run Docker Container') {
            steps {
                sh '''
                    CONTAINER_NAME="${APP_NAME}-main-${BUILD_NUMBER}"

                    docker rm -f "$CONTAINER_NAME" 2>/dev/null || true

                    docker run -d \
                        --name "$CONTAINER_NAME" \
                        -p 5000:5000 \
                        "${APP_NAME}:${BUILD_NUMBER}"

                    docker ps
                '''
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
